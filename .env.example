# ==============================================================================
# Configuração de Deploy WSW Redesign via API (.env)
# ==============================================================================
# Este arquivo é utilizado como fallback para o deploy individual por empresa
# quando o arquivo 'bash.md' não estiver presente.

# Domínio / URL base da API do backend WSW (com ou sem barra no final)
API_URL=https://api.seudominio.com

# Token de autenticação Bearer (Admin)
API_TOKEN=seu_token_admin_aqui

# ID da empresa alvo do deploy individual
COMPANY_ID=12
